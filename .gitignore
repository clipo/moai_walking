# System files
.DS_Store
Thumbs.db

# R specific files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Google Drive files
*.gdoc

# Temporary files
*~
*.tmp
*.bak

# Packrat files (legacy)
packrat/lib*/
# Keep packrat.lock and packrat/init.R for reproducibility
!packrat/packrat.lock
!packrat/init.R

# renv files
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
# Keep renv.lock and activation script for reproducibility
!renv/.gitignore
!renv/activate.R
!renv/settings.json

# Output figures (can be regenerated)
