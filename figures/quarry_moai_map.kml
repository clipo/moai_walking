<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Moai Near Rano Raraku Quarry</name>
  <description>All moai within 2km of quarry center, categorized by location type</description>
  
  <!-- Styles for different moai types -->
  <Style id="roadStyle">
    <IconStyle>
      <color>ff0000ff</color>
      <scale>1.2</scale>
      <Icon>
        <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
      </Icon>
    </IconStyle>
  </Style>
  
  <Style id="quarryNotBedrockStyle">
    <IconStyle>
      <color>ff00ff00</color>
      <scale>1.2</scale>
      <Icon>
        <href>http://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href>
      </Icon>
    </IconStyle>
  </Style>
  
  <Style id="quarryStyle">
    <IconStyle>
      <color>ff00ffff</color>
      <scale>1.0</scale>
      <Icon>
        <href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
      </Icon>
    </IconStyle>
  </Style>
  
  <Style id="quarryBedrockStyle">
    <IconStyle>
      <color>ff808080</color>
      <scale>1.0</scale>
      <Icon>
        <href>http://maps.google.com/mapfiles/kml/pushpin/wht-pushpin.png</href>
      </Icon>
    </IconStyle>
  </Style>
  
  <Style id="otherStyle">
    <IconStyle>
      <color>ffff00ff</color>
      <scale>0.8</scale>
      <Icon>
        <href>http://maps.google.com/mapfiles/kml/shapes/star.png</href>
      </Icon>
    </IconStyle>
  </Style>
  
  <!-- Quarry center marker -->
  <Placemark>
    <name>Rano Raraku Quarry Center</name>
    <description>Approximate center of quarry</description>
    <Point>
      <coordinates>-109.2767,-27.1247,0</coordinates>
    </Point>
  </Placemark>
  
